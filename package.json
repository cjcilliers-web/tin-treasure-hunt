    "url": "https://github.com/cjcilliers-web/tin-treasure-hunt/issues"
  },
  "homepage": "https://github.com/cjcilliers-web/tin-treasure-hunt#readme",
  "devDependencies": {
    "wrangler": "^4.145.0"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4"
  },
  "private": true
}
