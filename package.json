{
  "name": "tin-treasure-hunt",
  "version": "1.0.0",
  "description": "TIN Treasure Hunt: Explore. Discover. Reward.",
  "scripts": {
    "dev": "wrangler dev --local --test-scheduled",
    "db:migrate:local": "wrangler d1 migrations apply tin-treasure-hunt --local",
    "db:seed:local": "wrangler d1 execute tin-treasure-hunt --local --file seed/demo-cozumel.sql",
    "db:migrate": "wrangler d1 migrations apply tin-treasure-hunt --remote",
    "deploy": "wrangler deploy",
    "test:e2e": "node test/e2e.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cjcilliers-web/tin-treasure-hunt.git"
  },
  "keywords": [],
